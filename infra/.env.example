# Copy to infra/.env  (never commit .env)
POSTGRES_USER=dressme
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dressme
DATABASE_URL=postgresql+asyncpg://dressme:change_me@localhost:5432/dressme

# ---- real modules on PostgreSQL (python -m scripts.init_db creates the tables)
USE_MOCKS=true                  # modules without a switch below stay on their mock
M01_USE_MOCKS=false             # M1 wardrobe: real, items in Postgres + pgvector
M03_USE_MOCK=false              # M3 wear log: real
M03_DATABASE_URL=postgresql+psycopg2://dressme:change_me@localhost:5432/dressme
M04_DATABASE_URL=postgresql+psycopg2://dressme:change_me@localhost:5432/dressme
M02_USE_MOCK=false              # M2 outfits: real (python ml/scripts/m02/download_models.py once)
M04_USE_MOCK=false              # M4 calendar: real (uses M2)
M17_USE_MOCK=false              # M17 capsule: real (uses M2)
M07_REAL=m1,m2                  # BO6 local shops: the user's real wardrobe + outfits
M14_REAL=m7,m1,m2,m3,m6,m10,m15 # BO6 boutique: every real module (M5 comes from BO4 later)
# M09_USE_MOCK=false            # M9 3D: needs Blender (M09_BLENDER=C:/path/blender.exe)
# AUTH_STORE=json               # accounts in a JSON file instead of Postgres

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dressme

LLM_PROVIDER=openai             # anthropic | openai | ollama
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# OpenAI-compatible host used by M8. Paste a key only in infra/.env, never in git.
LLM_BASE_URL=https://api.groq.com/openai/v1

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
JWT_SECRET=change_me
