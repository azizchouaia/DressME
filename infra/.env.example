# Copy to infra/.env  (never commit .env)
POSTGRES_USER=dressme
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dressme
DATABASE_URL=postgresql+asyncpg://dressme:change_me@localhost:5432/dressme

# ---- every module runs for REAL (no mock). Modules not built yet (M5, M11, M12, M16, from BO3/BO4)
# answer "not available yet" (empty), never fake data.
USE_MOCKS=false
M03_DATABASE_URL=postgresql+psycopg2://dressme:change_me@localhost:5432/dressme
M04_DATABASE_URL=postgresql+psycopg2://dressme:change_me@localhost:5432/dressme
M05_M02_SOURCE=module           # BO4 style profile: M5 ranks the REAL M2 outfits (user's M1 pieces) by the learnt taste
M07_REAL=m1,m2                  # BO6 local shops: the user's real wardrobe + outfits
M14_REAL=m7,m1,m2,m3,m6,m10,m15 # BO6 boutique: the other real modules
# M2 needs its model weights once:  python ml/scripts/m02/download_models.py
# M9 (3D) needs Blender:            M09_BLENDER=C:/Program Files/Blender Foundation/Blender 4.2/blender.exe
# AUTH_STORE=json               # accounts in a JSON file instead of Postgres

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dressme

# ---- the LLM of the assistant (orchestrator), agents and M8. Two good free choices:
#  A) Groq (online, free key at console.groq.com, fast, very good at choosing the agents) - RECOMMENDED:
#     LLM_PROVIDER=groq
#     LLM_MODEL=llama-3.3-70b-versatile
#     LLM_API_KEY=gsk_...your key...
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#  B) Ollama (local, offline): qwen2.5:14b chooses tools much better than llama3.1:8b (ollama pull qwen2.5:14b)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1   # M8 talks to Ollama through its OpenAI-compatible API

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
JWT_SECRET=change_me
