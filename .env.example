# Copy to .env and adjust. Never commit .env.

# Backend
DATABASE_URL=postgresql+psycopg://wardrobe:wardrobe@localhost:5432/smart_wardrobe
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5287","http://127.0.0.1:5287"]

# Shared demo account ("Explore the demo wardrobe"). Disable in production.
SEED_DEMO_USER=true

# Storage: "local" writes to ./storage and serves it at /media.
# "s3" works with AWS S3, Cloudflare R2, Supabase Storage, MinIO (requires boto3).
STORAGE_BACKEND=local
STORAGE_PUBLIC_BASE_URL=/media
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# AI
CLOTHING_ANALYZER=local-heuristic

# Hosted stylist. Groq's OpenAI-compatible API.
# Copy this file to .env and paste your own Groq key. The key stays out of git.
# Other modules call POST /api/v1/stylist/chat. They do not call Groq themselves.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Photo → 3D on this computer. "unavailable" leaves the placeholder in place.
# "triposr" calls the local TripoSR service (ai/triposr_server.py).
GARMENT_PROCESSOR=unavailable
TRIPOSR_URL=http://127.0.0.1:8766

# Flutter talks to the API with --dart-define=API_URL=http://127.0.0.1:8765
# Android emulator: http://10.0.2.2:8765
# A phone on your Wi-Fi: http://<your-computer-ip>:8765
