  {
   "parameters": {
    "jsCode": "// what came back from each idea agent: who handled it and which tools ran\nreturn $input.all().map(i => {\n  const r = i.json, res = r.result || {};\n  const tools = (res.steps || []).filter(s => s.step === 'tool').map(s => `${s.to}.${s.action} (${s.ms} ms)`);\n  return { json: { idea_agent: r.agent, action: res.action, tools_called: tools.join(' → '),\n    llm_calls: (JSON.stringify(res.steps || []).match(/\"llm_(route|answer)\"/g) || []).length, data: res.data } };\n});"
   },
   "name": "BO1 agent · answer",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
